<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Kushat</AssemblyName>
    <Version>0.2.0</Version>
    <ApplicationIcon>Assets/Kushat.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kushat.Core/Kushat.Core.csproj" />
    <Resource Include="Assets/Kushat.ico" />
  </ItemGroup>
</Project>
