<Window x:Class="Kushat.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:core="clr-namespace:Kushat.Core;assembly=Kushat.Core" xmlns:local="clr-namespace:Kushat.App" FontSize="14" FontFamily="Segoe UI" Width="1380" Height="900" MinWidth="640" MinHeight="480" Closing="OnClosing" SizeChanged="WindowResized" Background="{DynamicResource AppBackgroundBrush}">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Controls.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="20">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel Margin="0,0,0,18"><TextBlock Text="Печать ценников" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="R-Keeper · Reference-сервер · Точные размеры на А4" Style="{StaticResource MutedText}" Margin="0,6,0,0"/><TextBlock x:Name="ConnectionText" Style="{StaticResource MutedText}" Margin="0,5,0,0"/></StackPanel>
 <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <WrapPanel><Button x:Name="ConnectButton" Content="Подключения…" Click="ConnectClick"/><Button x:Name="RefreshButton" Content="Обновить меню" Click="RefreshClick"/><Button x:Name="LogoutButton" Content="Выйти" Click="LogoutClick" IsEnabled="False"/><Button x:Name="CancelButton" Content="Отменить загрузку" Click="CancelClick" Visibility="Collapsed"/></WrapPanel>
 <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="SearchChanged" ToolTip="Поиск по наименованию или коду внутри выбранной ветки" Margin="0,6,0,0"/>
 </Grid>
 <Grid x:Name="BodyGrid" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="PrintColumn" Width="360"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid x:Name="CatalogPanel" Margin="0,0,16,0" Height="550">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="MenuColumn" Width="190" MinWidth="0"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="MenuPanel" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10">
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="Ветки меню" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <TextBlock x:Name="MenuNoticeText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
      <TreeView x:Name="MenuTree" BorderThickness="0" SelectedItemChanged="MenuBranchChanged" ScrollViewer.HorizontalScrollBarVisibility="Auto">
       <TreeView.ItemTemplate>
        <HierarchicalDataTemplate DataType="{x:Type core:MenuBranch}" ItemsSource="{Binding Children}">
         <TextBlock Text="{Binding Title}" ToolTip="{Binding Path}" Margin="0,4"/>
        </HierarchicalDataTemplate>
       </TreeView.ItemTemplate>
       <TreeView.ItemContainerStyle>
        <Style TargetType="TreeViewItem">
         <Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static core:MenuBranchKind.All}">
          <Setter Property="IsExpanded" Value="True"/><Setter Property="IsSelected" Value="True"/>
         </DataTrigger></Style.Triggers>
        </Style>
       </TreeView.ItemContainerStyle>
      </TreeView>
     </DockPanel>
    </Border>
    <GridSplitter x:Name="MenuSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="{DynamicResource BorderBrush}"/>
     <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
     <Button x:Name="MenuToggleButton" Content="Скрыть ветки" Click="ToggleMenuClick" Padding="10,5"/>
     <Button x:Name="SelectButton" Content="Выбрать найденные" Click="SelectVisibleClick" Padding="10,5"/>
     <Button x:Name="ClearButton" Content="Снять весь выбор" Click="ClearSelectionClick" Padding="10,5"/>
    </WrapPanel>
    <TextBlock x:Name="MenuFilterText" Grid.Row="1" Margin="0,0,0,10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
    <DataGrid x:Name="ProductsGrid" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
      HeadersVisibility="Column" RowHeight="42" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" GridLinesVisibility="Horizontal"
      SelectionChanged="ProductFocusChanged" SelectionMode="Extended" EnableRowVirtualization="True">
     <DataGrid.Columns>
      <DataGridTemplateColumn Header="✓" Width="44">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanPrint}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" MinWidth="170" IsReadOnly="True"/>
      <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price}" Width="100" IsReadOnly="True"/>
      <DataGridTemplateColumn Header="За" Width="70">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding UnitTitle}" ToolTip="{Binding UnitError}" VerticalAlignment="Center" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="Ценников" Width="90">
       <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox IsEnabled="{Binding CanPrint}" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Margin="4" ToolTip="Количество экземпляров этого ценника"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
   </Grid>

 </Grid>
 <Border x:Name="PrintCard" Grid.Column="1" Style="{StaticResource Card}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinHeight="100">
 <StackPanel>
 <TextBlock Text="Параметры печати" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,16"/>
 <local:SmoothExpander x:Name="PrinterSettings" Header="Принтер и тип цены"><StackPanel><TextBlock Text="Принтер Windows" Margin="0,0,0,7"/><ComboBox x:Name="PrinterBox" SelectionChanged="PrinterChanged"/><Button Content="Обновить принтеры" Click="ReloadPrintersClick" Margin="0,8,0,12"/><StackPanel x:Name="PriceTypePanel" Visibility="Collapsed"><TextBlock Text="Тип цены" Margin="0,0,0,7"/><ComboBox x:Name="PriceTypeBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="PriceTypeChanged"/><TextBlock Text="Основной тип выбирается автоматически." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></StackPanel></local:SmoothExpander>
 <local:SmoothExpander x:Name="LabelSettings" Header="Ценник: оформление и размер"><StackPanel>
 <TextBlock Text="Сохранённый шаблон" Margin="0,0,0,7"/><ComboBox x:Name="PresetBox" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectionChanged="PresetChanged" Margin="0,0,0,12"/>
 <TextBlock Text="Оформление" Margin="0,0,0,7"/><ComboBox x:Name="TemplateBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TemplateChanged"/><TextBlock x:Name="TemplateDescription" Style="{StaticResource MutedText}" Margin="0,8,0,12"/>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ширина, мм" Margin="0,0,0,7"/><TextBox x:Name="LabelWidthBox" TextChanged="DimensionsChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Высота, мм" Margin="0,0,0,7"/><TextBox x:Name="LabelHeightBox" TextChanged="DimensionsChanged"/></StackPanel></Grid>
 <Button Content="Поменять ширину и высоту" Click="SwapDimensionsClick" Margin="0,8,0,8"/>
 <TextBlock x:Name="FormatErrorText" Foreground="#B8404C" TextWrapping="Wrap" Margin="0,0,0,8"/>
 <TextBlock Text="Название своего шаблона" Margin="0,0,0,7"/><TextBox x:Name="PresetNameBox" MaxLength="80"/><Button Content="Сохранить шаблон" Click="SavePresetClick" Margin="0,8,0,8"/>
 <TextBlock x:Name="PresetStatusText" Style="{StaticResource MutedText}"/><TextBlock Text="Весовые — за 100 г. Штучные — за штуку." Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
 </StackPanel></local:SmoothExpander>
 <local:SmoothExpander x:Name="AppearanceSettings" Header="Оформление программы"><ComboBox x:Name="ThemeBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="ThemeChanged"/></local:SmoothExpander>
 </StackPanel></ScrollViewer>
 <StackPanel Grid.Row="1" Margin="0,12,0,0">
 <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="10" Padding="10"><Viewbox x:Name="TemplatePreview" Height="155" Stretch="Uniform"/></Border>
 <TextBlock x:Name="PreviewSizeText" MaxHeight="42" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,10"/>
 <TextBlock x:Name="SummaryText" FontSize="15" TextWrapping="Wrap" LineHeight="24" Margin="0,0,0,12"/>
 <Button x:Name="PreviewButton" Content="Предварительный просмотр" Click="PreviewClick" Margin="0,0,0,8"/><Button x:Name="PrintButton" Content="Напечатать…" Click="PrintClick" Style="{StaticResource PrimaryButton}" Margin="0"/>
 </StackPanel></Grid></Border>
 </Grid>
 <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource MutedText}" Text="Нажмите «Подключения…» и укажите свой сервер R-Keeper."/>
 </Grid></ScrollViewer>
</Window>